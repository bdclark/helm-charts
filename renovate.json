{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "customManagers:helmChartYamlAppVersions"
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "linuxserver/qbittorrent"
      ],
      "allowedVersions": "/^[0-9]\\.[0-9]+\\.[0-9]+$/"
    },
    {
      "description": "Bump chart version patch when Renovate updates chart app/image references",
      "matchFileNames": [
        "charts/**/Chart.yaml",
        "charts/**/values.yaml"
      ],
      "bumpVersions": [
        {
          "name": "Helm chart version patch bump",
          "filePatterns": [
            "{{packageFileDir}}/Chart.yaml"
          ],
          "matchStrings": [
            "version:\\s*\"?(?<version>\\d+\\.\\d+\\.\\d+)\"?"
          ],
          "bumpType": "patch"
        }
      ]
    },
    {
      "description": "Keep primary chart application image patches separate from minor updates",
      "matchDatasources": ["docker"],
      "matchFileNames": [
        "charts/**/Chart.yaml"
      ],
      "separateMinorPatch": true
    },
    {
      "description": "Automerge primary chart application image patches",
      "matchDatasources": ["docker"],
      "matchFileNames": [
        "charts/**/Chart.yaml"
      ],
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "automergeType": "pr"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/versions\\.env$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>.*?)\\s+depName=(?<depName>.*?)\\n[A-Z_]+=(?<currentValue>.*)"
      ],
      "extractVersionTemplate": "^v?(?<version>.*)$"
    }
  ]
}
